@model BrasilBurger.ViewModels.CompteModifierProfilModel
@{
    ViewData["Title"] = "Modifier mon profil";
}

<div class="container">
    <h1>Modifier mon profil</h1>
    
    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-body">
                    <form asp-action="Profil" method="post">
                        @if (TempData["SuccessMessage"] != null)
                        {
                            <div class="alert alert-success">
                                @TempData["SuccessMessage"]
                            </div>
                        }
                        
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Nom" class="form-label">Nom</label>
                                <input asp-for="Nom" class="form-control" />
                                <span asp-validation-for="Nom" class="text-danger"></span>
                            </div>
                            
                            <div class="col-md-6 mb-3">
                                <label asp-for="Prenom" class="form-label">Prénom</label>
                                <input asp-for="Prenom" class="form-control" />
                                <span asp-validation-for="Prenom" class="text-danger"></span>
                            </div>
                        </div>
                        
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">Email</label>
                            <input asp-for="Email" class="form-control" type="email" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                        
                        <div class="mb-3">
                            <label asp-for="Telephone" class="form-label">Téléphone</label>
                            <input asp-for="Telephone" class="form-control" />
                            <span asp-validation-for="Telephone" class="text-danger"></span>
                        </div>
                        
                        <div class="mb-3">
                            <label asp-for="Adresse" class="form-label">Adresse</label>
                            <textarea asp-for="Adresse" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Adresse" class="text-danger"></span>
                        </div>
                        
                        <h4 class="mt-4 mb-3">Modifier le mot de passe</h4>
                        <p class="text-muted">Laissez vide si vous ne voulez pas changer le mot de passe</p>
                        
                        <div class="mb-3">
                            <label asp-for="CurrentPassword" class="form-label">Mot de passe actuel</label>
                            <input asp-for="CurrentPassword" class="form-control" type="password" />
                            <span asp-validation-for="CurrentPassword" class="text-danger"></span>
                        </div>
                        
                        <div class="mb-3">
                            <label asp-for="NewPassword" class="form-label">Nouveau mot de passe</label>
                            <input asp-for="NewPassword" class="form-control" type="password" />
                            <span asp-validation-for="NewPassword" class="text-danger"></span>
                        </div>
                        
                        <div class="mb-3">
                            <label asp-for="ConfirmNewPassword" class="form-label">Confirmer le nouveau mot de passe</label>
                            <input asp-for="ConfirmNewPassword" class="form-control" type="password" />
                            <span asp-validation-for="ConfirmNewPassword" class="text-danger"></span>
                        </div>
                        
                        <div class="d-flex justify-content-between">
                            <a href="@Url.Action("Index", "Compte")" class="btn btn-secondary">Retour</a>
                            <button type="submit" class="btn btn-primary">Enregistrer les modifications</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>