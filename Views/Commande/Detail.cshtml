@model BrasilBurger.ViewModels.CommandeViewModel
@{
    ViewData["Title"] = "Détails de la commande";
}

<div class="container mt-4">
    <h1>Détails de la commande #@Model.Id</h1>
    
    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Informations de la commande</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <p><strong>Date:</strong> @Model.DateCommande.ToString("dd/MM/yyyy HH:mm")</p>
                            <p><strong>Type livraison:</strong> 
                                @Model.TypeLivraison switch
                                {
                                    "SUR_PLACE" => <span>Sur place</span>,
                                    "A_EMPORTER" => <span>À emporter</span>,
                                    "LIVRAISON" => <span>Livraison</span>,
                                    _ => <span>@Model.TypeLivraison</span>
                                }
                            </p>
                            @if (!string.IsNullOrEmpty(Model.AdresseLivraison))
                            {
                                <p><strong>Adresse:</strong> @Model.AdresseLivraison</p>
                            }
                        </div>
                        <div class="col-md-6">
                            <p><strong>Statut:</strong> 
                                @{
                                    var badgeClass = Model.Etat switch
                                    {
                                        "EN_ATTENTE" => "bg-warning",
                                        "VALIDEE" => "bg-success",
                                        "EN_PREPARATION" => "bg-info",
                                        "PRETE" => "bg-primary",
                                        "EN_LIVRAISON" => "bg-secondary",
                                        "LIVREE" => "bg-dark",
                                        "ANNULEE" => "bg-danger",
                                        _ => "bg-secondary"
                                    };
                                }
                                <span class="badge @badgeClass">@Model.Etat</span>
                            </p>
                            <p><strong>Paiement:</strong> 
                                @if (Model.Payee)
                                {
                                    <span class="badge bg-success">Payée</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">À payer</span>
                                }
                            </p>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="card mt-4">
                <div class="card-header">
                    <h5 class="mb-0">Articles commandés</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Article</th>
                                    <th>Quantité</th>
                                    <th>Prix unitaire</th>
                                    <th>Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td>@item.Nom (@item.Type)</td>
                                        <td>@item.Quantite</td>
                                        <td>@item.PrixUnitaire.ToString("N0") FCFA</td>
                                        <td>@item.Total.ToString("N0") FCFA</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="3" class="text-end"><strong>Total:</strong></td>
                                    <td class="text-success fw-bold">@Model.Total.ToString("N0") FCFA</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Actions</h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a href="@Url.Action("MesCommandes", "Commande")" class="btn btn-outline-primary">
                            <i class="fas fa-arrow-left"></i> Retour à mes commandes
                        </a>
                        
                        @if (Model.Etat == "EN_ATTENTE" && !Model.Payee)
                        {
                            <a href="@Url.Action("Paiement", "Paiement", new { commandeId = Model.Id })" 
                               class="btn btn-success">
                                <i class="fas fa-credit-card"></i> Payer la commande
                            </a>
                            
                            <button type="button" 
                                    class="btn btn-outline-danger btn-annuler-detail" 
                                    data-id="@Model.Id">
                                <i class="fas fa-times"></i> Annuler la commande
                            </button>
                        }
                        
                        @if (Model.Payee)
                        {
                            <a href="#" class="btn btn-outline-secondary">
                                <i class="fas fa-receipt"></i> Télécharger la facture
                            </a>
                        }
                    </div>
                </div>
            </div>
            
            <div class="card mt-4">
                <div class="card-header">
                    <h5 class="mb-0">Informations</h5>
                </div>
                <div class="card-body">
                    <p>Pour toute question concernant votre commande, contactez-nous :</p>
                    <p><i class="fas fa-phone"></i> +221 33 123 45 67</p>
                    <p><i class="fas fa-envelope"></i> contact@brasilburger.sn</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Annulation depuis la page détail
        document.querySelector('.btn-annuler-detail')?.addEventListener('click', function() {
            const commandeId = this.getAttribute('data-id');
            
            if (confirm('Êtes-vous sûr de vouloir annuler cette commande ?')) {
                fetch(`/Commande/Annuler/${commandeId}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        alert(data.message);
                        location.reload();
                    } else {
                        alert('Erreur: ' + data.message);
                    }
                })
                .catch(error => {
                    console.error('Erreur:', error);
                    alert('Une erreur est survenue');
                });
            }
        });
    </script>
}