<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Brasil Burger - @ViewData["Title"]</title>
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" />
    
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <!-- Version compacte avec Bootstrap -->
        <nav class="navbar navbar-dark py-2" style="background-color: #000;">
            <div class="container">
                <!-- Logo et nom - Brasil Burger en orange -->
                <a class="navbar-brand d-flex align-items-center" href="/">
                    <img src="~/images/logo.png" alt="Brasil Burger Logo" style="height: 35px;" class="me-2" />
                    <span class="brand-name fw-bold" style="color: #FF8C00;">Brasil Burger</span>
                </a>
                
                <!-- Menu pour desktop - Liens en blanc -->
                <div class="d-none d-md-flex align-items-center">
                    <a href="/" class="text-white mx-3 text-decoration-none">
                        <i class="fas fa-home me-1"></i> Accueil
                    </a>
                    <a href="/Home/Catalogue?type=burgers" class="text-white mx-3 text-decoration-none">
                        <i class="fas fa-hamburger me-1"></i> Burgers
                    </a>
                    <a href="/Home/Catalogue?type=menus" class="text-white mx-3 text-decoration-none">
                        <i class="fas fa-utensils me-1"></i> Menus
                    </a>
                    <a href="/Home/About" class="text-white mx-3 text-decoration-none">
                        <i class="fas fa-info-circle me-1"></i> À propos
                    </a>
                    <a href="/Home/Contact" class="text-white mx-3 text-decoration-none">
                        <i class="fas fa-envelope me-1"></i> Contact
                    </a>
                </div>
                
                <!-- Actions utilisateur pour desktop - Texte en blanc -->
                <div class="d-none d-md-flex align-items-center">
                    @if (ViewBag.IsAuthenticated == true)
                    {
                        <div class="dropdown">
                            <a class="text-white text-decoration-none dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                <i class="fas fa-user-circle me-1"></i> @ViewBag.ClientPrenom
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="/Compte"><i class="fas fa-user me-2"></i> Mon Compte</a></li>
                                <li><a class="dropdown-item" href="/Commande/MesCommandes"><i class="fas fa-clipboard-list me-2"></i> Mes Commandes</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form asp-controller="Auth" asp-action="Logout" method="post" class="dropdown-item">
                                        <button type="submit" class="btn btn-link p-0 text-decoration-none w-100 text-start">
                                            <i class="fas fa-sign-out-alt me-2"></i> Déconnexion
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a href="/Auth/Login" class="text-white mx-2 text-decoration-none">
                            <i class="fas fa-sign-in-alt me-1"></i> Connexion
                        </a>
                        <a href="/Auth/Register" class="text-white mx-2 text-decoration-none">
                            <i class="fas fa-user-plus me-1"></i> Inscription
                        </a>
                    }
                </div>
                
                <!-- Bouton menu mobile -->
                <button class="navbar-toggler d-md-none" type="button" data-bs-toggle="collapse" data-bs-target="#mobileMenu">
                    <span class="navbar-toggler-icon"></span>
                </button>
            </div>
            
            <!-- Menu mobile - Liens en blanc -->
            <div class="collapse d-md-none" id="mobileMenu" style="background-color: #000;">
                <div class="container py-3">
                    <div class="d-flex flex-column">
                        <a href="/" class="text-white py-2 text-decoration-none">
                            <i class="fas fa-home me-2"></i> Accueil
                        </a>
                        <a href="/Home/Catalogue?type=burgers" class="text-white py-2 text-decoration-none">
                            <i class="fas fa-hamburger me-2"></i> Burgers
                        </a>
                        <a href="/Home/Catalogue?type=menus" class="text-white py-2 text-decoration-none">
                            <i class="fas fa-utensils me-2"></i> Menus
                        </a>
                        <a href="/Home/About" class="text-white py-2 text-decoration-none">
                            <i class="fas fa-info-circle me-2"></i> À propos
                        </a>
                        <a href="/Home/Contact" class="text-white py-2 text-decoration-none">
                            <i class="fas fa-envelope me-2"></i> Contact
                        </a>
                        
                        <hr class="text-white my-2">
                        
                        @if (ViewBag.IsAuthenticated == true)
                        {
                            <a href="/Compte" class="text-white py-2 text-decoration-none">
                                <i class="fas fa-user me-2"></i> Mon Compte
                            </a>
                            <a href="/Commande/MesCommandes" class="text-white py-2 text-decoration-none">
                                <i class="fas fa-clipboard-list me-2"></i> Mes Commandes
                            </a>
                            <form asp-controller="Auth" asp-action="Logout" method="post" class="py-2">
                                <button type="submit" class="btn btn-link p-0 text-white text-decoration-none">
                                    <i class="fas fa-sign-out-alt me-2"></i> Déconnexion
                                </button>
                            </form>
                        }
                        else
                        {
                            <a href="/Auth/Login" class="text-white py-2 text-decoration-none">
                                <i class="fas fa-sign-in-alt me-2"></i> Connexion
                            </a>
                            <a href="/Auth/Register" class="text-white py-2 text-decoration-none">
                                <i class="fas fa-user-plus me-2"></i> Inscription
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container mt-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- Footer avec Bootstrap - Fond noir, titres orange, texte blanc -->
    <footer class="bg-black text-white mt-5">
        <div class="container py-5">
            <div class="row">
                <div class="col-md-3 mb-4">
                    <h5 class="text-warning mb-3" style="color: #FF8C00;">Brasil Burger</h5>
                    <p class="text-white mb-1">Le meilleur burger de Dakar</p>
                </div>
                <div class="col-md-3 mb-4">
                    <h5 class="mb-3" style="color: #FF8C00;">Contact</h5>
                    <p class="text-white mb-1"><i class="fas fa-phone me-2"></i> +221 33 123 45 67</p>
                    <p class="text-white mb-1"><i class="fas fa-envelope me-2"></i> contact@brasilburger.sn</p>
                    <p class="text-white"><i class="fas fa-map-marker-alt me-2"></i> Dakar, Sénégal</p>
                </div>
                <div class="col-md-3 mb-4">
                    <h5 class="mb-3" style="color: #FF8C00;">Horaires</h5>
                    <p class="text-white mb-1">Lun-Dim: 11h-23h</p>
                    <p class="text-white">Livraison: 12h-22h</p>
                </div>
                <div class="col-md-3 mb-4">
                    <h5 class="mb-3" style="color: #FF8C00;">Suivez-nous</h5>
                    <div class="d-flex mt-3">
                        <a href="#" class="text-white me-3"><i class="fab fa-facebook fa-lg"></i></a>
                        <a href="#" class="text-white me-3"><i class="fab fa-instagram fa-lg"></i></a>
                        <a href="#" class="text-white"><i class="fab fa-twitter fa-lg"></i></a>
                    </div>
                </div>
            </div>
            <div class="text-center pt-4 border-top border-secondary">
                <p class="mb-0 text-white">&copy; @DateTime.Now.Year Brasil Burger. Tous droits réservés.</p>
            </div>
        </div>
    </footer>

    <!-- Scripts (sans duplication) -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"></script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>