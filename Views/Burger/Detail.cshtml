@* @model BrasilBurger.Models.Burger
@{
    ViewData["Title"] = Model.Nom;
    var complements = ViewBag.Complements as List<BrasilBurger.Models.Complement>;
}

<div class="container">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Accueil</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Burgers</a></li>
            <li class="breadcrumb-item active">@Model.Nom</li>
        </ol>
    </nav>
    
    <div class="row">
        <div class="col-lg-6 mb-4">
            <div class="card">
                <img src="@Model.Image" class="card-img-top" alt="@Model.Nom">
            </div>
        </div>
        
        <div class="col-lg-6">
            <div class="card">
                <div class="card-body">
                    <h1 class="h2 mb-3">@Model.Nom</h1>
                    <p class="lead mb-4">@Model.Description</p>
                    
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="h2 text-warning">@Model.Prix.ToString("C")</div>
                        @if (!Model.Archived)
                        {
                            <span class="badge bg-danger">Indisponible</span>
                        }
                    </div>
                    
                    @if (Model.Archived)
                    {
                        <!-- Compléments -->
                        @if (complements != null && complements.Any())
                        {
                            <div class="mb-4">
                                <h5 class="mb-3">Ajouter des compléments</h5>
                                <div class="row g-2" id="complementsList">
                                    @foreach (var complement in complements)
                                    {
                                        <div class="col-md-6">
                                            <div class="form-check">
                                                <input type="checkbox" class="form-check-input complement-checkbox" 
                                                       id="complement-@complement.Id" value="@complement.Id">
                                                <label class="form-check-label d-flex justify-content-between" 
                                                       for="complement-@complement.Id">
                                                    <span>@complement.Nom</span>
                                                    <span class="text-muted">+@complement.Prix.ToString("C")</span>
                                                </label>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                        
                        <!-- Quantité -->
                        <div class="mb-4">
                            <h5 class="mb-3">Quantité</h5>
                            <div class="d-flex align-items-center">
                                <button class="btn btn-outline-secondary" id="btnMinus">
                                    <i class="fas fa-minus"></i>
                                </button>
                                <input type="number" class="form-control text-center mx-2" 
                                       id="quantity" value="1" min="1" max="10" style="width: 70px;">
                                <button class="btn btn-outline-secondary" id="btnPlus">
                                    <i class="fas fa-plus"></i>
                                </button>
                            </div>
                        </div>
                        
                        <!-- Bouton ajouter au panier -->
                        <div class="d-grid">
                            @if (ViewBag.ClientConnecte == true)
                            {
                                <button class="btn btn-success btn-lg" id="btnAjouterPanier" 
                                        data-burger-id="@Model.Id">
                                    <i class="fas fa-cart-plus me-2"></i>
                                    Ajouter au panier
                                </button>
                            }
                            else
                            {
                                <button class="btn btn-success btn-lg" disabled 
                                        title="Connectez-vous pour ajouter au panier">
                                    <i class="fas fa-cart-plus me-2"></i>
                                    Connectez-vous pour commander
                                </button>
                                <a asp-controller="Auth" asp-action="Login" 
                                   class="btn btn-primary btn-lg mt-2">
                                    <i class="fas fa-sign-in-alt me-2"></i>
                                    Se connecter
                                </a>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            Ce burger est temporairement indisponible.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            let quantity = 1;
            
            // Gérer la quantité
            $('#btnMinus').on('click', function() {
                if (quantity > 1) {
                    quantity--;
                    $('#quantity').val(quantity);
                }
            });
            
            $('#btnPlus').on('click', function() {
                if (quantity < 10) {
                    quantity++;
                    $('#quantity').val(quantity);
                }
            });
            
            $('#quantity').on('change', function() {
                let val = parseInt($(this).val());
                if (isNaN(val) || val < 1) val = 1;
                if (val > 10) val = 10;
                quantity = val;
                $(this).val(quantity);
            });
            
            // Ajouter au panier
            $('#btnAjouterPanier').on('click', function() {
                const burgerId = $(this).data('burger-id');
                const complementsIds = [];
                
                // Récupérer les compléments sélectionnés
                $('.complement-checkbox:checked').each(function() {
                    complementsIds.push(parseInt($(this).val()));
                });
                
                $.ajax({
                    url: '@Url.Action("AjouterAuPanier", "Burger")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        ProduitId: burgerId,
                        TypeProduit: 'burger',
                        Quantite: quantity,
                        ComplementsIds: complementsIds
                    }),
                    headers: {
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function(response) {
                        if (response.success) {
                            toastr.success(response.message);
                            // Mettre à jour le compteur du panier
                            $('#panierCount').text(response.panierCount || 0);
                        } else {
                            toastr.error(response.message);
                        }
                    },
                    error: function() {
                        toastr.error('Une erreur est survenue');
                    }
                });
            });
        });
    </script>
} *@

@model BrasilBurger.ViewModels.BurgerDetailViewModel

@{
    ViewData["Title"] = Model.Nom;
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <img src="@(string.IsNullOrEmpty(Model.Image) ? "/images/default-burger.jpg" : Model.Image)" 
                     class="card-img-top" 
                     alt="@Model.Nom"
                     style="height: 400px; object-fit: cover;">
            </div>
        </div>
        
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h1 class="card-title">@Model.Nom</h1>
                    <h3 class="text-primary">@Model.Prix.ToString("N0") FCFA</h3>
                    
                    <div class="mb-4">
                        <h5>Description</h5>
                        <p class="card-text">@Model.Description</p>
                    </div>
                    
                    <div class="d-grid gap-2">
                        @if (ViewBag.IsAuthenticated == true)
                        {
                            <a href="/Burger/CommanderBurger/@Model.Id" class="btn btn-primary btn-lg">
                                <i class="fas fa-shopping-cart"></i> Commander maintenant
                            </a>
                        }
                        else
                        {
                            <a href="/Auth/Login?returnUrl=/Burger/CommanderBurger/@Model.Id" class="btn btn-primary btn-lg">
                                <i class="fas fa-sign-in-alt"></i> Se connecter pour commander
                            </a>
                        }
                        <a href="/Home/Catalogue?type=burgers" class="btn btn-outline-secondary">
                            <i class="fas fa-arrow-left"></i> Retour au catalogue
                        </a>
                    </div>
                </div>
            </div>
            
            <!-- Section Compléments -->
            @if (Model.Complements.Any())
            {
                <div class="card mt-4">
                    <div class="card-header">
                        <h5 class="mb-0">Compléments disponibles</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            @foreach (var complement in Model.Complements)
                            {
                                <div class="col-md-6 mb-2">
                                    <div class="d-flex justify-content-between align-items-center p-2 border rounded">
                                        <div>
                                            <h6 class="mb-0">@complement.Nom</h6>
                                            <small class="text-muted">@complement.Type</small>
                                        </div>
                                        <span class="text-primary">+@complement.Prix.ToString("N0") FCFA</span>
                                    </div>
                                </div>
                            }
                        </div>
                        <p class="text-muted mt-2 mb-0">
                            <small>Les compléments peuvent être ajoutés lors de la commande</small>
                        </p>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Styles {
    <style>
        .card {
            border: none;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            border-radius: 10px;
            overflow: hidden;
        }
        
        .card-img-top {
            border-radius: 10px 10px 0 0;
        }
        
        .card-body {
            padding: 2rem;
        }
        
        .card-title {
            color: #333;
            font-weight: bold;
            margin-bottom: 1rem;
        }
        
        .btn-primary {
            background-color: #FF6B00;
            border-color: #FF6B00;
            padding: 12px 30px;
            font-weight: bold;
        }
        
        .btn-primary:hover {
            background-color: #E55A00;
            border-color: #E55A00;
        }
        
        .btn-outline-secondary {
            padding: 12px 30px;
            font-weight: bold;
        }
    </style>
}