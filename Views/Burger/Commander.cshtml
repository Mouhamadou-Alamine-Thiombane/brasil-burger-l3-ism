@model BrasilBurger.ViewModels.CreateCommandeViewModel
@{
    ViewData["Title"] = "Commander";
}

<div class="container mt-4">
    <h1>Passer une commande</h1>
    
    <!-- ✅ FIX: Afficher les erreurs -->
    @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
    {
        <div class="alert alert-danger">
            @Html.Raw(ViewBag.ErrorMessage)
        </div>
    }
    
    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-body">
                    <!-- ✅ FIX: Supprimez id="commandeForm" et utilisez juste form -->
                    <form asp-action="Create" asp-controller="Commande" method="post" id="commandeForm">
                        @Html.AntiForgeryToken()
                        
                        <!-- Champs cachés pour l'ID du produit -->
                        @if (Model.BurgerId.HasValue)
                        {
                            <input type="hidden" asp-for="BurgerId" value="@Model.BurgerId" />
                            <div class="alert alert-info">
                                <h5>Commande d'un burger</h5>
                            </div>
                        }
                        else if (Model.MenuId.HasValue)
                        {
                            <input type="hidden" asp-for="MenuId" value="@Model.MenuId" />
                            <div class="alert alert-info">
                                <h5>Commande d'un menu</h5>
                            </div>
                        }
                        
                        <!-- Quantité -->
                        <div class="mb-3">
                            <label asp-for="Quantite" class="form-label">Quantité</label>
                            <input asp-for="Quantite" class="form-control" type="number" min="1" value="@Model.Quantite" required />
                        </div>
                        
                        <!-- Type de livraison -->
                        <div class="mb-3">
                            <label asp-for="TypeLivraison" class="form-label">Type de livraison</label>
                            <select asp-for="TypeLivraison" class="form-control" id="typeLivraison" required>
                                <option value="">Sélectionnez un type</option>
                                <option value="SUR_PLACE">Sur place</option>
                                <option value="A_EMPORTER">À emporter</option>
                                <option value="LIVRAISON">Livraison</option>
                            </select>
                        </div>
                        
                        <!-- Zone de livraison -->
                        <div class="mb-3" id="zoneContainer" style="display: none;">
                            <label asp-for="ZoneId" class="form-label">Zone de livraison</label>
                            <select asp-for="ZoneId" class="form-control" id="zoneSelect">
                                <option value="">Sélectionnez une zone</option>
                            </select>
                        </div>
                        
                        <!-- Adresse de livraison -->
                        <div class="mb-3" id="adresseContainer" style="display: none;">
                            <label asp-for="AdresseLivraison" class="form-label">Adresse de livraison</label>
                            <textarea asp-for="AdresseLivraison" class="form-control" rows="3" placeholder="Entrez votre adresse complète" id="AdresseLivraison"></textarea>
                        </div>
                        
                        <!-- Compléments -->
                        @if (Model.BurgerId.HasValue && ViewBag.Complements != null)
                        {
                            <div class="mb-3">
                                <label class="form-label">Compléments (optionnel)</label>
                                <div class="row">
                                    @foreach (var complement in ViewBag.Complements)
                                    {
                                        <div class="col-md-6 mb-2">
                                            <div class="form-check">
                                                <input type="checkbox"
                                                       name="ComplementIds"
                                                       value="@complement.Id"
                                                       class="form-check-input complement-checkbox"
                                                       id="complement-@complement.Id" />
                                                <label class="form-check-label" for="complement-@complement.Id">
                                                    @complement.Nom (+@complement.Prix FCFA)
                                                </label>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                        
                        <div class="d-grid gap-2">
                            <!-- ✅ FIX: Revenez à type="submit" -->
                            <button type="submit" class="btn btn-primary btn-lg">Confirmer la commande</button>
                            <a href="javascript:history.back()" class="btn btn-outline-secondary">Retour</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        
        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Récapitulatif</h5>
                </div>
                <div class="card-body">
                    <p>Votre commande sera préparée sous 20-30 minutes.</p>
                    <p>Pour les livraisons, le délai estimé est de 45-60 minutes.</p>
                    <hr>
                    <p><strong>Instructions :</strong></p>
                    <ul>
                        <li>Sur place : Récupérez au comptoir</li>
                        <li>À emporter : Prêt dans 20-30 min</li>
                        <li>Livraison : Livré à votre adresse</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Initialisation
        document.addEventListener('DOMContentLoaded', function() {
            // Définir la valeur initiale du type de livraison
            const typeLivraisonSelect = document.getElementById('typeLivraison');
            if (typeLivraisonSelect.value) {
                toggleLivraisonFields(typeLivraisonSelect.value);
            }
            
            // Événement de changement
            typeLivraisonSelect.addEventListener('change', function() {
                toggleLivraisonFields(this.value);
            });
            
            // Charger les zones si nécessaire
            if (typeLivraisonSelect.value === 'LIVRAISON') {
                loadZones();
            }
        });
        
        function toggleLivraisonFields(type) {
            const isLivraison = type === 'LIVRAISON';
            document.getElementById('zoneContainer').style.display = isLivraison ? 'block' : 'none';
            document.getElementById('adresseContainer').style.display = isLivraison ? 'block' : 'none';
            
            const zoneSelect = document.getElementById('zoneSelect');
            const adresseField = document.getElementById('AdresseLivraison');
            
            if (isLivraison) {
                zoneSelect.setAttribute('required', 'required');
                adresseField.setAttribute('required', 'required');
                loadZones();
            } else {
                zoneSelect.removeAttribute('required');
                adresseField.removeAttribute('required');
            }
        }
        
        async function loadZones() {
            try {
                const response = await fetch('/Commande/GetZones');
                const zones = await response.json();
                
                const select = document.getElementById('zoneSelect');
                select.innerHTML = '<option value="">Sélectionnez une zone</option>';
                
                zones.forEach(zone => {
                    const option = document.createElement('option');
                    option.value = zone.id;
                    option.textContent = `${zone.nom} (+${zone.prix} FCFA)`;
                    select.appendChild(option);
                });
                
                // Sélectionner la valeur existante si présente
                const currentValue = '@Model.ZoneId';
                if (currentValue) {
                    select.value = currentValue;
                }
            } catch (error) {
                console.error('Erreur lors du chargement des zones:', error);
            }
        }
    </script>
}