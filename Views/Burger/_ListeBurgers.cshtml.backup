@model IEnumerable<BrasilBurger.Models.Burger>

@if (!Model.Any())
{
    <div class="col-12 text-center py-5">
        <div class="alert alert-info">
            <i class="fas fa-info-circle me-2"></i>
            Aucun burger ne correspond à votre recherche.
        </div>
    </div>
}
else
{
    <div class="row">
        @foreach (var burger in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100">
                    <img src="@burger.ImageUrl" class="card-img-top" alt="@burger.Nom">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@burger.Nom</h5>
                        <p class="card-text flex-grow-1">@burger.Description</p>
                        <div class="mt-3">
                            <div class="h4 text-warning mb-3">@burger.Prix.ToString("C")</div>
                            <div class="d-grid">
                                <a href="@Url.Action("Details", new { id = burger.Id })" 
                                   class="btn btn-primary">Voir détails</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}