@model BrasilBurger.ViewModels.PaiementViewModel
@{
    ViewData["Title"] = "Paiement";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow">
                <div class="card-header text-white" style="background-color: #FF6B35;">
                    <h4 class="mb-0"><i class="fas fa-credit-card me-2"></i>Paiement</h4>
                </div>
                <div class="card-body">
                    <!-- ✅ FIX: Changé de "Payer" à "ProcessPaiement" -->
                    <form asp-action="ProcessPaiement" method="post">
                        @Html.AntiForgeryToken()
                        
                        <input type="hidden" asp-for="CommandeId" />
                        <input type="hidden" asp-for="Montant" />
                        
                        <div class="mb-4 text-center">
                            <h3>Montant à payer : <span class="text-warning">@Model.Montant.ToString("C")</span></h3>
                            <p class="text-muted">Commande N° @Model.CommandeId</p>
                        </div>
                        
                        <div class="mb-4">
                            <h5 class="mb-3">Méthode de paiement</h5>
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <div class="card method-card @(Model.Methode == "WAVE" ? "selected" : "")" 
                                         data-method="WAVE">
                                        <div class="card-body text-center">
                                            <div class="mb-3">
                                                <i class="fas fa-mobile-alt fa-3x" style="color: #00BFFF;"></i>
                                            </div>
                                            <h5>Wave</h5>
                                            <!-- ✅ FIX: Valeur en majuscules pour correspondre à la base de données -->
                                            <input type="radio" class="btn-check" name="Methode" 
                                                   id="wave" value="WAVE" @(Model.Methode == "WAVE" ? "checked" : "") required>
                                            <label class="btn btn-outline-primary mt-2" for="wave">
                                                Choisir Wave
                                            </label>
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="col-md-6 mb-3">
                                    <div class="card method-card @(Model.Methode == "OM" ? "selected" : "")" 
                                         data-method="OM">
                                        <div class="card-body text-center">
                                            <div class="mb-3">
                                                <i class="fas fa-mobile-alt fa-3x" style="color: #FF6600;"></i>
                                            </div>
                                            <h5>Orange Money</h5>
                                            <!-- ✅ FIX: Valeur en majuscules -->
                                            <input type="radio" class="btn-check" name="Methode" 
                                                   id="om" value="OM" @(Model.Methode == "OM" ? "checked" : "")>
                                            <label class="btn btn-outline-warning mt-2" for="om">
                                                Choisir OM
                                            </label>
                                        </div>
                                    </div>
                                </div>
                                
                                <!-- ✅ AJOUT: Option pour carte bancaire -->
                                <div class="col-md-6 mb-3">
                                    <div class="card method-card @(Model.Methode == "CARTE" ? "selected" : "")" 
                                         data-method="CARTE">
                                        <div class="card-body text-center">
                                            <div class="mb-3">
                                                <i class="fas fa-credit-card fa-3x" style="color: #28a745;"></i>
                                            </div>
                                            <h5>Carte Bancaire</h5>
                                            <input type="radio" class="btn-check" name="Methode" 
                                                   id="carte" value="CARTE" @(Model.Methode == "CARTE" ? "checked" : "")>
                                            <label class="btn btn-outline-success mt-2" for="carte">
                                                Choisir Carte
                                            </label>
                                        </div>
                                    </div>
                                </div>
                                
                                <!-- ✅ AJOUT: Option pour espèces -->
                                <div class="col-md-6 mb-3">
                                    <div class="card method-card @(Model.Methode == "ESPECES" ? "selected" : "")" 
                                         data-method="ESPECES">
                                        <div class="card-body text-center">
                                            <div class="mb-3">
                                                <i class="fas fa-money-bill-wave fa-3x" style="color: #6c757d;"></i>
                                            </div>
                                            <h5>Espèces</h5>
                                            <input type="radio" class="btn-check" name="Methode" 
                                                   id="especes" value="ESPECES" @(Model.Methode == "ESPECES" ? "checked" : "")>
                                            <label class="btn btn-outline-secondary mt-2" for="especes">
                                                Choisir Espèces
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <span asp-validation-for="Methode" class="text-danger"></span>
                        </div>
                        
                        <!-- Détails Wave -->
                        <div id="waveDetails" class="paiement-details" style="display: @(Model.Methode == "WAVE" ? "block" : "none")">
                            <div class="alert alert-info">
                                <h6><i class="fas fa-info-circle me-2"></i>Instructions Wave :</h6>
                                <p class="mb-0">
                                    1. Vous recevrez une notification sur votre téléphone<br>
                                    2. Confirmez le paiement dans l'application Wave<br>
                                    3. Montant: <strong>@Model.Montant.ToString("C")</strong>
                                </p>
                            </div>
                            <div class="mb-3">
                                <label for="NumeroWave" class="form-label">Numéro Wave (optionnel)</label>
                                <input type="tel" class="form-control" id="NumeroWave" name="NumeroWave" 
                                       placeholder="Ex: 77 123 45 67" value="@Model.NumeroWave">
                            </div>
                        </div>
                        
                        <!-- Détails Orange Money -->
                        <div id="omDetails" class="paiement-details" style="display: @(Model.Methode == "OM" ? "block" : "none")">
                            <div class="alert alert-warning">
                                <h6><i class="fas fa-info-circle me-2"></i>Instructions Orange Money :</h6>
                                <p class="mb-0">
                                    1. Vous recevrez un code USSD<br>
                                    2. Suivez les instructions et entrez votre code PIN<br>
                                    3. Montant: <strong>@Model.Montant.ToString("C")</strong>
                                </p>
                            </div>
                            <div class="mb-3">
                                <label for="NumeroOM" class="form-label">Numéro Orange Money (optionnel)</label>
                                <input type="tel" class="form-control" id="NumeroOM" name="NumeroOM"
                                       placeholder="Ex: 77 123 45 67" value="@Model.NumeroOM">
                            </div>
                        </div>
                        
                        <!-- Référence de paiement -->
                        <div class="mb-3">
                            <label asp-for="Reference" class="form-label">Référence de paiement (optionnel)</label>
                            <input asp-for="Reference" class="form-control" 
                                   placeholder="Numéro de transaction, code, etc." />
                            <span asp-validation-for="Reference" class="text-danger"></span>
                        </div>
                        
                        <div class="alert alert-success">
                            <div class="d-flex">
                                <i class="fas fa-shield-alt fa-2x me-3"></i>
                                <div>
                                    <h6 class="alert-heading">Paiement 100% Sécurisé</h6>
                                    <p class="mb-0 small">
                                        Vos informations sont cryptées et protégées.
                                    </p>
                                </div>
                            </div>
                        </div>
                        
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success btn-lg">
                                <i class="fas fa-lock me-2"></i>Payer @Model.Montant.ToString("C")
                            </button>
                            <a asp-controller="Commande" asp-action="Detail" asp-route-id="@Model.CommandeId" 
                               class="btn btn-outline-secondary">
                                <i class="fas fa-arrow-left me-2"></i>Retour à la commande
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <style>
        .method-card {
            cursor: pointer;
            transition: all 0.3s ease;
            border: 2px solid transparent;
        }
        .method-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }
        .method-card.selected {
            border-color: #FF6B35;
            background-color: rgba(255, 107, 53, 0.05);
        }
    </style>
    <script>
        $(document).ready(function() {
            // Gérer le changement de méthode de paiement
            $('input[name="Methode"]').on('change', function() {
                const method = $(this).val();
                
                // Mettre à jour la sélection visuelle
                $('.method-card').removeClass('selected');
                $(`.method-card[data-method="${method}"]`).addClass('selected');
                
                // Afficher/masquer les détails
                $('.paiement-details').hide();
                $(`#${method.toLowerCase()}Details`).show();
            });
            
            // Gérer le clic sur les cartes
            $('.method-card').on('click', function() {
                const method = $(this).data('method');
                $(`#${method.toLowerCase()}`).prop('checked', true).trigger('change');
            });
            
            // Validation du formulaire
            $('#paiementForm').on('submit', function(e) {
                const selectedMethod = $('input[name="Methode"]:checked');
                if (!selectedMethod.length) {
                    e.preventDefault();
                    alert('Veuillez sélectionner une méthode de paiement');
                    return false;
                }
                return true;
            });
        });
    </script>
}