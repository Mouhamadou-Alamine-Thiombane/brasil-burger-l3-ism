@{
    ViewData["Title"] = "À propos";
}

<div class="container">
    <div class="hero-section text-center py-5 mb-5" style="background-color: #FF6B35; color: white; border-radius: 15px;">
        <h1 class="display-4 fw-bold mb-3">À propos de Brasil Burger</h1>
        <p class="lead">L'art du burger brésilien depuis 2020</p>
    </div>
    
    <div class="row mb-5">
        <div class="col-lg-6 mb-4">
            <h2 class="mb-4" style="color: #FF6B35;">Notre histoire</h2>
            <p class="lead">
                Fondé en 2020, Brasil Burger est né de la passion pour les saveurs authentiques du Brésil 
                et l'amour des bons burgers.
            </p>
            <p>
                Nous avons commencé avec un petit food truck dans les rues de Dakar, partageant notre amour 
                pour les burgers faits maison avec des ingrédients frais et locaux.
            </p>
            <p>
                Aujourd'hui, nous avons grandi pour devenir l'une des chaînes de burgers les plus appréciées, 
                tout en conservant notre engagement envers la qualité et l'authenticité.
            </p>
        </div>
        <div class="col-lg-6 mb-4">
            <img src="/images/about.jpg" alt="Notre équipe" class="img-fluid rounded">
        </div>
    </div>
    
    <div class="row mb-5">
        <div class="col-12 text-center mb-4">
            <h2 style="color: #FF6B35;">Nos valeurs</h2>
        </div>
        <div class="col-md-4 mb-4">
            <div class="card text-center h-100">
                <div class="card-body">
                    <i class="fas fa-leaf fa-3x mb-3" style="color: #28a745;"></i>
                    <h4>Fraîcheur</h4>
                    <p>Nous utilisons uniquement des ingrédients frais et de saison.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="card text-center h-100">
                <div class="card-body">
                    <i class="fas fa-heart fa-3x mb-3" style="color: #dc3545;"></i>
                    <h4>Passion</h4>
                    <p>Chaque burger est préparé avec amour et attention.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="card text-center h-100">
                <div class="card-body">
                    <i class="fas fa-users fa-3x mb-3" style="color: #17a2b8;"></i>
                    <h4>Communauté</h4>
                    <p>Nous soutenons les producteurs locaux et notre communauté.</p>
                </div>
            </div>
        </div>
    </div>
    
    <div class="card mb-5">
        <div class="card-header text-white" style="background-color: #FF6B35;">
            <h4 class="mb-0"><i class="fas fa-clock me-2"></i>Nos horaires</h4>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <h5>Restaurant</h5>
                    <ul class="list-unstyled">
                        <li><strong>Lundi - Vendredi :</strong> 11h00 - 22h00</li>
                        <li><strong>Samedi :</strong> 11h00 - 23h00</li>
                        <li><strong>Dimanche :</strong> 12h00 - 21h00</li>
                    </ul>
                </div>
                <div class="col-md-6">
                    <h5>Livraison</h5>
                    <ul class="list-unstyled">
                        <li><strong>Lundi - Dimanche :</strong> 11h00 - 21h00</li>
                        <li>Livraison dans un rayon de 10km</li>
                        <li>Délai moyen : 45 minutes</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>