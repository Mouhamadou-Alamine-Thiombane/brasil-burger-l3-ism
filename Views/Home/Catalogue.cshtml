@model BrasilBurger.ViewModels.CatalogueViewModel
@{
    ViewData["Title"] = "Catalogue";
    var typeCatalogue = ViewBag.TypeCatalogue as string ?? "burgers";
}

<div class="container">
    <h1 class="mb-4" style="color: #FF6B35;">Notre Catalogue</h1>
    
    <!-- Filtres -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-center gap-2">
                        <a href="@Url.Action("Catalogue", "Home", new { type = "tous" })" 
                           class="btn @(typeCatalogue == "tous" ? "btn-primary" : "btn-outline-primary")">
                            Tous
                        </a>
                        <a href="@Url.Action("Catalogue", "Home", new { type = "burgers" })" 
                           class="btn @(typeCatalogue == "burgers" ? "btn-primary" : "btn-outline-primary")">
                            Burgers
                        </a>
                        <a href="@Url.Action("Catalogue", "Home", new { type = "menus" })" 
                           class="btn @(typeCatalogue == "menus" ? "btn-primary" : "btn-outline-primary")">
                            Menus
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Burgers -->
    @if (Model.Burgers != null && Model.Burgers.Any() && (typeCatalogue == "tous" || typeCatalogue == "burgers"))
    {
        <h2 class="mb-3">Nos Burgers</h2>
        <div class="row">
            @foreach (var burger in Model.Burgers)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100">
                        <img src="@burger.ImageUrl" class="card-img-top" alt="@burger.Nom" style="height: 200px; object-fit: cover;">
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@burger.Nom</h5>
                            <p class="card-text flex-grow-1">@burger.Description</p>
                            <div class="mt-3">
                                <div class="h4 text-warning mb-3">@burger.Prix.ToString("C")</div>
                                <div class="d-grid">
                                    <a href="@Url.Action("DetailsBurger", "Home", new { id = burger.Id })" 
                                       class="btn btn-primary">Voir détails</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    
    <!-- Menus -->
    @if (Model.Menus != null && Model.Menus.Any() && (typeCatalogue == "tous" || typeCatalogue == "menus"))
    {
        <h2 class="mb-3 mt-5">Nos Menus</h2>
        <div class="row">
            @foreach (var menu in Model.Menus)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100">
                        <img src="@menu.ImageUrl" class="card-img-top" alt="@menu.Nom" style="height: 200px; object-fit: cover;">
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@menu.Nom</h5>
                            <p class="card-text flex-grow-1">
                                @(menu.Burger?.Nom + " + " + menu.Complement?.Nom)
                            </p>
                            <div class="mt-3">
                                <div class="h4 text-warning mb-3">@menu.PrixTotal.ToString("C")</div>
                                <div class="d-grid">
                                    <a href="@Url.Action("DetailsMenu", "Home", new { id = menu.Id })" 
                                       class="btn btn-primary">Voir détails</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    
    @if ((Model.Burgers == null || !Model.Burgers.Any()) && (Model.Menus == null || !Model.Menus.Any()))
    {
        <div class="alert alert-info text-center py-5">
            <i class="fas fa-info-circle fa-3x mb-3"></i>
            <h4>Aucun produit disponible pour le moment</h4>
            <p class="mb-0">Revenez bientôt pour découvrir nos nouvelles offres !</p>
        </div>
    }
</div>