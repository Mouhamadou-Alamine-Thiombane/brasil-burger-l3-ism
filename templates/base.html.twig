<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Brasil Burger - Gestion{% endblock %}</title>
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    
    <style>
        :root {
            --primary-color: #FF6B35;
            --secondary-color: #FF8E53;
            --accent-color: #FFC107;
            --dark-color: #333333;
            --light-color: #F8F9FA;
        }
        
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f5f5f5;
        }
        
        .navbar {
            background-color: var(--primary-color) !important;
            box-shadow: 0 2px 4px rgba(0,0,0,.1);
        }
        
        .navbar-brand {
            font-weight: bold;
            font-size: 1.5rem;
        }
        
        .sidebar {
            background-color: white;
            min-height: calc(100vh - 56px);
            box-shadow: 0 0 10px rgba(0,0,0,.1);
        }
        
        .sidebar .nav-link {
            color: var(--dark-color);
            padding: 0.75rem 1rem;
            border-left: 3px solid transparent;
            transition: all 0.3s;
        }
        
        .sidebar .nav-link:hover,
        .sidebar .nav-link.active {
            background-color: rgba(255, 107, 53, 0.1);
            border-left-color: var(--primary-color);
            color: var(--primary-color);
        }
        
        .sidebar .nav-link i {
            width: 20px;
            margin-right: 10px;
        }
        
        .card {
            border: none;
            border-radius: 10px;
            box-shadow: 0 0 20px rgba(0,0,0,.05);
            margin-bottom: 20px;
        }
        
        .card-header {
            background-color: white;
            border-bottom: 1px solid #eee;
            font-weight: 600;
        }
        
        .stat-card {
            border-radius: 10px;
            padding: 20px;
            margin-bottom: 20px;
        }
        
        .stat-card-primary {
            border-left: 4px solid var(--primary-color);
        }
        
        .stat-card-success {
            border-left: 4px solid #28a745;
        }
        
        .stat-card-info {
            border-left: 4px solid #17a2b8;
        }
        
        .stat-card-warning {
            border-left: 4px solid #ffc107;
        }
        
        .stat-card-danger {
            border-left: 4px solid #dc3545;
        }
        
        .btn-primary {
            background-color: var(--primary-color);
            border-color: var(--primary-color);
        }
        
        .btn-primary:hover {
            background-color: var(--secondary-color);
            border-color: var(--secondary-color);
        }
        
        .badge-primary {
            background-color: var(--primary-color);
        }
        
        .table th {
            border-top: none;
            font-weight: 600;
            color: var(--dark-color);
        }
        
        .table td {
            vertical-align: middle;
        }
        
        .badge-etat {
            padding: 5px 10px;
            border-radius: 20px;
            font-weight: 500;
        }
        
        .badge-en-attente {
            background-color: #ffc107;
            color: #000;
        }
        
        .badge-validee {
            background-color: #17a2b8;
            color: white;
        }
        
        .badge-en-preparation {
            background-color: #007bff;
            color: white;
        }
        
        .badge-prete {
            background-color: #28a745;
            color: white;
        }
        
        .badge-en-livraison {
            background-color: #6c757d;
            color: white;
        }
        
        .badge-livree {
            background-color: #343a40;
            color: white;
        }
        
        .badge-annulee {
            background-color: #dc3545;
            color: white;
        }
        
        .badge-terminee {
            background-color: #20c997;
            color: white;
        }
    </style>
    
    {% block stylesheets %}{% endblock %}
</head>
<body>
    <!-- Navigation principale -->
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container-fluid">
            <a class="navbar-brand" href="{{ path('gestion_dashboard') }}">
                <i class="fas fa-hamburger me-2"></i>Brasil Burger - Gestion
            </a>
            
            <div class="d-flex">
                <span class="navbar-text text-white me-3">
                    <i class="fas fa-calendar-alt me-1"></i>
                    {{ "now"|date("d/m/Y H:i") }}
                </span>
                <a href="{{ path('gestion_aide') }}" class="btn btn-sm btn-light">
                    <i class="fas fa-question-circle me-1"></i>Aide
                </a>
            </div>
        </div>
    </nav>

    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <div class="col-md-3 col-lg-2 px-0">
                <div class="sidebar">
                    <nav class="nav flex-column pt-3">
                        <a class="nav-link {{ app.request.attributes.get('_route') == 'gestion_dashboard' ? 'active' : '' }}" 
                           href="{{ path('gestion_dashboard') }}">
                            <i class="fas fa-tachometer-alt"></i> Tableau de bord
                        </a>
                        
                        <div class="nav-link text-muted small mt-3">GESTION DES COMMANDES</div>
                        <a class="nav-link {{ app.request.attributes.get('_route') starts with 'gestion_commande' ? 'active' : '' }}" 
                           href="{{ path('gestion_commande_index') }}">
                            <i class="fas fa-shopping-cart"></i> Commandes
                        </a>
                        <a class="nav-link" href="{{ path('gestion_commande_affectation_livraison') }}">
                            <i class="fas fa-truck"></i> Affectation Livraison
                        </a>
                        
                        <div class="nav-link text-muted small mt-3">GESTION DES PRODUITS</div>
                        <a class="nav-link {{ app.request.attributes.get('_route') starts with 'gestion_burger' ? 'active' : '' }}" 
                           href="{{ path('gestion_burger_index') }}">
                            <i class="fas fa-hamburger"></i> Burgers
                        </a>
                        <a class="nav-link {{ app.request.attributes.get('_route') starts with 'gestion_menu' ? 'active' : '' }}" 
                           href="{{ path('gestion_menu_index') }}">
                            <i class="fas fa-list"></i> Menus
                        </a>
                        <a class="nav-link {{ app.request.attributes.get('_route') starts with 'gestion_complement' ? 'active' : '' }}" 
                           href="{{ path('gestion_complement_index') }}">
                            <i class="fas fa-french-fries"></i> Compléments
                        </a>
                        
                        <div class="nav-link text-muted small mt-3">GESTION DES CLIENTS</div>
                        <a class="nav-link {{ app.request.attributes.get('_route') starts with 'gestion_client' ? 'active' : '' }}" 
                           href="{{ path('gestion_client_index') }}">
                            <i class="fas fa-users"></i> Clients
                        </a>
                        
                        <div class="nav-link text-muted small mt-3">STATISTIQUES</div>
                        <a class="nav-link {{ app.request.attributes.get('_route') starts with 'gestion_statistiques' ? 'active' : '' }}" 
                           href="{{ path('gestion_statistiques') }}">
                            <i class="fas fa-chart-bar"></i> Statistiques
                        </a>
                    </nav>
                </div>
            </div>

            <!-- Contenu principal -->
            <div class="col-md-9 col-lg-10 px-4 py-3">
                <!-- Messages flash -->
                {% for type, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="alert alert-{{ type }} alert-dismissible fade show" role="alert">
                            {{ message }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    {% endfor %}
                {% endfor %}

                {% block body %}{% endblock %}
            </div>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    {% block javascripts %}{% endblock %}
</body>
</html>