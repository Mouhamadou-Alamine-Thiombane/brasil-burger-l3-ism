{% extends 'base.html.twig' %}

{% block title %}Gestion des burgers - Brasil Burger{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <h1 class="h3 mb-0">
                    <i class="fas fa-hamburger me-2"></i>Gestion des burgers
                </h1>
                <a href="{{ path('gestion_burger_new') }}" class="btn btn-primary">
                    <i class="fas fa-plus me-2"></i>Nouveau burger
                </a>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nom</th>
                            <th>Description</th>
                            <th>Prix</th>
                            <th>Image</th>
                            <th>Créé le</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for burger in burgers %}
                        <tr>
                            <td>#{{ burger.id }}</td>
                            <td>
                                <strong>{{ burger.nom }}</strong>
                            </td>
                            <td>
                                <small class="text-muted">{{ burger.description|default('Aucune description')|slice(0, 50) }}...</small>
                            </td>
                            <td>{{ burger.prix|format_currency('XOF') }}</td>
                            <td>
                                {% if burger.image %}
                                    <img src="{{ burger.image }}" alt="{{ burger.nom }}" style="width: 50px; height: 50px; object-fit: cover; border-radius: 5px;">
                                {% else %}
                                    <span class="badge bg-secondary">Aucune</span>
                                {% endif %}
                            </td>
                            <td>{{ burger.createdAt|date('d/m/Y') }}</td>
                            <td>
                                {% if burger.archived %}
                                    <span class="badge bg-danger">Archivé</span>
                                {% else %}
                                    <span class="badge bg-success">Actif</span>
                                {% endif %}
                            </td>
                            <td>
                                <div class="btn-group btn-group-sm" role="group">
                                    <a href="{{ path('gestion_burger_edit', {'id': burger.id}) }}" 
                                       class="btn btn-outline-primary" title="Modifier">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <form method="post" action="{{ path('gestion_burger_archive', {'id': burger.id}) }}" 
                                          class="d-inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('archive' ~ burger.id) }}">
                                        <button type="submit" class="btn btn-outline-warning" title="{{ burger.archived ? 'Désarchiver' : 'Archiver' }}">
                                            <i class="fas {{ burger.archived ? 'fa-box-open' : 'fa-archive' }}"></i>
                                        </button>
                                    </form>
                                    <form method="post" action="{{ path('gestion_burger_delete', {'id': burger.id}) }}" 
                                          class="d-inline" onsubmit="return confirm('Supprimer ce burger ?')">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ burger.id) }}">
                                        <button type="submit" class="btn btn-outline-danger" title="Supprimer">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="8" class="text-center py-4">
                                <i class="fas fa-hamburger fa-2x text-muted mb-3"></i>
                                <p class="text-muted">Aucun burger enregistré</p>
                                <a href="{{ path('gestion_burger_new') }}" class="btn btn-primary">
                                    <i class="fas fa-plus me-2"></i>Ajouter votre premier burger
                                </a>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}