{% extends 'base.html.twig' %}

{% block title %}Gestion des commandes - Brasil Burger{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <h1 class="h3 mb-0">
                    <i class="fas fa-shopping-cart me-2"></i>Gestion des commandes
                </h1>
                <a href="{{ path('gestion_commande_affectation_livraison') }}" class="btn btn-warning">
                    <i class="fas fa-truck me-2"></i>Affecter livreur
                </a>
            </div>
        </div>
    </div>

    <!-- Filtres -->
<div class="card mb-4">
    <div class="card-header">
        <h6 class="mb-0 font-weight-bold">
            <i class="fas fa-filter me-2"></i>Filtres
        </h6>
    </div>
    <div class="card-body">
        {{ form_start(filterForm) }}
        <div class="row">
            <div class="col-md-3 mb-3">
                {{ form_row(filterForm.numero) }}
            </div>
            <div class="col-md-3 mb-3">
                {{ form_row(filterForm.client) }}
            </div>
            <div class="col-md-3 mb-3">
                {{ form_row(filterForm.telephone) }}
            </div>
            <div class="col-md-3 mb-3">
                {{ form_row(filterForm.etat) }}
            </div>
        </div>
        
        <div class="row">
            <div class="col-md-3 mb-3">
                {{ form_row(filterForm.typeLivraison) }}
            </div>
            <div class="col-md-3 mb-3">
                {{ form_row(filterForm.dateDebut) }}
            </div>
            <div class="col-md-3 mb-3">
                {{ form_row(filterForm.dateFin) }}
            </div>
            <div class="col-md-3 mb-3 d-flex align-items-end">
                <div class="d-grid gap-2 w-100">
                    {{ form_widget(filterForm.filtrer) }}
                    {{ form_widget(filterForm.reinitialiser) }}
                </div>
            </div>
        </div>
        {{ form_end(filterForm) }}
    </div>
</div>

    <!-- Liste des commandes -->
    <div class="card">
        <div class="card-body">
            {% if commandes is not empty %}
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>N° Commande</th>
                                <th>Client</th>
                                <th>Date</th>
                                <th>Total</th>
                                <th>État</th>
                                <th>Type</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for commande in commandes %}
                            <tr>
                                <td><strong>#{{ commande.id }}</strong></td>
                                <td>
                                    {{ commande.client.nom }} {{ commande.client.prenom }}
                                    <br>
                                    <small class="text-muted">{{ commande.client.telephone }}</small>
                                </td>
                                <td>{{ commande.dateCommande|date('d/m/Y H:i') }}</td>
                                <td>{{ commande.total|number_format(0, ',', ' ') }} FCFA</td>
                                <td>
                                    <span class="badge badge-etat badge-{{ commande.etat|lower|replace({'_': '-'}) }}">
                                        {{ commande.etat }}
                                    </span>
                                </td>
                                <td>
                                    {% if commande.typeLivraison == 'SUR_PLACE' %}
                                        <span class="badge bg-secondary">Sur place</span>
                                    {% elseif commande.typeLivraison == 'A_EMPORTER' %}
                                        <span class="badge bg-info">À emporter</span>
                                    {% else %}
                                        <span class="badge bg-warning">Livraison</span>
                                    {% endif %}
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a href="{{ path('gestion_commande_show', {'id': commande.id}) }}" 
                                           class="btn btn-outline-primary" title="Voir">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        {% if commande.etat == 'EN_ATTENTE' %}
                                            <form method="post" action="{{ path('gestion_commande_valider', {'id': commande.id}) }}" 
                                                  class="d-inline">
                                                <input type="hidden" name="_token" value="{{ csrf_token('validate' ~ commande.id) }}">
                                                <button type="submit" class="btn btn-outline-success" title="Valider">
                                                    <i class="fas fa-check"></i>
                                                </button>
                                            </form>
                                            <form method="post" action="{{ path('gestion_commande_annuler', {'id': commande.id}) }}" 
                                                  class="d-inline">
                                                <input type="hidden" name="_token" value="{{ csrf_token('cancel' ~ commande.id) }}">
                                                <button type="submit" class="btn btn-outline-danger" title="Annuler">
                                                    <i class="fas fa-times"></i>
                                                </button>
                                            </form>
                                        {% endif %}
                                    </div>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <div class="text-center py-5">
                    <i class="fas fa-shopping-cart fa-3x text-muted mb-3"></i>
                    <h4 class="text-muted">Aucune commande trouvée</h4>
                    <p class="text-muted">Aucune commande ne correspond à vos critères de filtrage.</p>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}