{% extends 'base.html.twig' %}

{% block title %}Gestion des compléments - Brasil Burger{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <h1 class="h3 mb-0">
                    <i class="fas fa-utensils me-2"></i>Gestion des compléments
                </h1>
                <a href="{{ path('gestion_complement_new') }}" class="btn btn-primary">
                    <i class="fas fa-plus me-2"></i>Nouveau complément
                </a>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            {% if complements is not empty %}
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Nom</th>
                                <th>Type</th>
                                <th>Prix</th>
                                <th>Créé le</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for complement in complements %}
                            <tr>
                                <td>#{{ complement.id }}</td>
                                <td>
                                    <strong>{{ complement.nom }}</strong>
                                </td>
                                <td>
                                    {% if complement.type == 'FRITE' %}
                                        <span class="badge bg-warning">Frites</span>
                                    {% else %}
                                        <span class="badge bg-info">Boisson</span>
                                    {% endif %}
                                </td>
                                <td>{{ complement.prix|number_format(0, ',', ' ') }} FCFA</td>
                                <td>{{ complement.createdAt|date('d/m/Y') }}</td>
                                <td>
                                    {% if complement.archived %}
                                        <span class="badge bg-danger">Archivé</span>
                                    {% else %}
                                        <span class="badge bg-success">Actif</span>
                                    {% endif %}
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a href="{{ path('gestion_complement_edit', {'id': complement.id}) }}" 
                                           class="btn btn-outline-primary" title="Modifier">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <form method="post" action="{{ path('gestion_complement_archive', {'id': complement.id}) }}" 
                                              class="d-inline">
                                            <input type="hidden" name="_token" value="{{ csrf_token('archive' ~ complement.id) }}">
                                            <button type="submit" class="btn btn-outline-warning" title="{{ complement.archived ? 'Désarchiver' : 'Archiver' }}">
                                                <i class="fas {{ complement.archived ? 'fa-box-open' : 'fa-archive' }}"></i>
                                            </button>
                                        </form>
                                        <form method="post" action="{{ path('gestion_complement_delete', {'id': complement.id}) }}" 
                                              class="d-inline" onsubmit="return confirm('Supprimer ce complément ?')">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ complement.id) }}">
                                            <button type="submit" class="btn btn-outline-danger" title="Supprimer">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <div class="text-center py-5">
                    <i class="fas fa-utensils fa-3x text-muted mb-3"></i>
                    <h4 class="text-muted">Aucun complément trouvé</h4>
                    <p class="text-muted">Commencez par ajouter votre premier complément.</p>
                    <a href="{{ path('gestion_complement_new') }}" class="btn btn-primary mt-3">
                        <i class="fas fa-plus me-2"></i>Ajouter un complément
                    </a>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}