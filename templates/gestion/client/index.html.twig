{% extends 'base.html.twig' %}

{% block title %}Gestion des clients - Brasil Burger{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <h1 class="h3 mb-0">
                    <i class="fas fa-users me-2"></i>Gestion des clients
                </h1>
                <div>
                    <form method="get" class="d-flex">
                        <input type="text" name="search" class="form-control me-2" 
                               placeholder="Rechercher un client..." value="{{ search }}">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-search"></i>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nom & Prénom</th>
                            <th>Téléphone</th>
                            <th>Email</th>
                            <th>Adresse</th>
                            <th>Inscrit le</th>
                            <th>Commandes</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for client in clients %}
                        {% if not client.archived %}
                        <tr>
                            <td>#{{ client.id }}</td>
                            <td>
                                <strong>{{ client.nom }} {{ client.prenom }}</strong>
                            </td>
                            <td>{{ client.telephone }}</td>
                            <td>{{ client.email }}</td>
                            <td>
                                <small class="text-muted">{{ client.adresse|default('Non renseignée')|slice(0, 30) }}{% if client.adresse|length > 30 %}...{% endif %}</small>
                            </td>
                            <td>{{ client.createdAt|date('d/m/Y') }}</td>
                            <td>
                                <span class="badge bg-primary">{{ client.commandes|length }}</span>
                            </td>
                            <td>
                                <a href="{{ path('gestion_client_show', {'id': client.id}) }}" 
                                   class="btn btn-sm btn-info" title="Voir">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <form method="post" action="{{ path('gestion_client_delete', {'id': client.id}) }}" 
                                      class="d-inline" onsubmit="return confirm('Archiver ce client ?')">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ client.id) }}">
                                    <button type="submit" class="btn btn-sm btn-danger" title="Archiver">
                                        <i class="fas fa-archive"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                        {% endif %}
                        {% else %}
                        <tr>
                            <td colspan="8" class="text-center py-4">
                                <i class="fas fa-users fa-2x text-muted mb-3"></i>
                                <p class="text-muted">Aucun client trouvé</p>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}