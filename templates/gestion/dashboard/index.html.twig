{% extends 'base.html.twig' %}

{% block title %}Tableau de bord - Brasil Burger{% endblock %}

{% block body %}
<div class="container-fluid">
    <!-- En-tête -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="h3 mb-0">Tableau de bord</h1>
                    <p class="text-muted mb-0">Aujourd'hui : {{ aujourdhui|date('d/m/Y') }}</p>
                </div>
                <div>
                    <a href="{{ path('gestion_statistiques') }}" class="btn btn-outline-primary">
                        <i class="fas fa-chart-bar me-2"></i>Statistiques détaillées
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Cartes de statistiques -->
    <div class="row mb-4">
        <!-- Commandes en cours -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card stat-card stat-card-primary h-100">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                                Commandes en cours
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">
                                {{ statistiques.commandesEnCours|length }}
                            </div>
                            <div class="mt-2 mb-0 text-muted text-xs">
                                <i class="fas fa-clock me-1"></i>En attente/préparation
                            </div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-clock fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Commandes validées -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card stat-card stat-card-success h-100">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                                Commandes validées
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">
                                {{ statistiques.commandesValidees[0].count|default(0) }}
                            </div>
                            <div class="mt-2 mb-0 text-muted text-xs">
                                <i class="fas fa-check-circle me-1"></i>Aujourd'hui
                            </div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-check-circle fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Recette journalière -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card stat-card stat-card-info h-100">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-info text-uppercase mb-1">
                                Recette journalière
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">
                                {{ statistiques.recetteJournaliere|format_currency('XOF') }}
                            </div>
                            <div class="mt-2 mb-0 text-muted text-xs">
                                <i class="fas fa-money-bill-wave me-1"></i>Total des paiements
                            </div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-money-bill-wave fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Commandes annulées -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card stat-card stat-card-danger h-100">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-danger text-uppercase mb-1">
                                Commandes annulées
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">
                                {{ statistiques.commandesAnnulees[0].count|default(0) }}
                            </div>
                            <div class="mt-2 mb-0 text-muted text-xs">
                                <i class="fas fa-times-circle me-1"></i>Aujourd'hui
                            </div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-times-circle fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Contenu principal -->
    <div class="row">
        <!-- Commandes récentes -->
        <div class="col-lg-8 mb-4">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 font-weight-bold">
                        <i class="fas fa-shopping-cart me-2"></i>Commandes récentes
                    </h6>
                    <a href="{{ path('gestion_commande_index') }}" class="btn btn-sm btn-primary">
                        <i class="fas fa-list me-1"></i>Toutes les commandes
                    </a>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>N° Commande</th>
                                    <th>Client</th>
                                    <th>Total</th>
                                    <th>État</th>
                                    <th>Type</th>
                                    <th>Heure</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for commande in statistiques.commandesEnCours|slice(0, 10) %}
                                <tr>
                                    <td><strong>#{{ commande.id }}</strong></td>
                                    <td>
                                        {{ commande.client.nom }} {{ commande.client.prenom }}
                                        <br>
                                        <small class="text-muted">{{ commande.client.telephone }}</small>
                                    </td>
                                    <td>{{ commande.total|format_currency('XOF') }}</td>
                                    <td>
                                        <span class="badge badge-etat badge-{{ commande.etat.value|lower|replace({'_': '-'}) }}">
                                            {{ commande.etat.value }}
                                        </span>
                                    </td>
                                    <td>
                                        {% if commande.typeLivraison == 'SUR_PLACE' %}
                                            <span class="badge bg-secondary">Sur place</span>
                                        {% elseif commande.typeLivraison == 'A_EMPORTER' %}
                                            <span class="badge bg-info">À emporter</span>
                                        {% else %}
                                            <span class="badge bg-warning">Livraison</span>
                                        {% endif %}
                                    </td>
                                    <td>{{ commande.dateCommande|date('H:i') }}</td>
                                    <td>
                                        <a href="{{ path('gestion_commande_show', {'id': commande.id}) }}" 
                                           class="btn btn-sm btn-outline-primary" title="Voir">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                                {% else %}
                                <tr>
                                    <td colspan="7" class="text-center py-4">
                                        <i class="fas fa-shopping-cart fa-2x text-muted mb-3"></i>
                                        <p class="text-muted">Aucune commande aujourd'hui</p>
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Burgers les plus vendus -->
        <div class="col-lg-4 mb-4">
            <div class="card">
                <div class="card-header">
                    <h6 class="mb-0 font-weight-bold">
                        <i class="fas fa-hamburger me-2"></i>Burgers les plus vendus
                    </h6>
                </div>
                <div class="card-body">
                    {% if statistiques.burgersPlusVendus is not empty %}
                        <div class="list-group">
                            {% for burger in statistiques.burgersPlusVendus %}
                            <div class="list-group-item list-group-item-action">
                                <div class="d-flex w-100 justify-content-between">
                                    <h6 class="mb-1">{{ burger.nom }}</h6>
                                    <span class="badge bg-primary rounded-pill">{{ burger.quantite_vendue }}</span>
                                </div>
                                <p class="mb-1 small text-muted">
                                    Chiffre d'affaires : {{ burger.chiffre_affaires|format_currency('XOF') }}
                                </p>
                            </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="text-center py-4">
                            <i class="fas fa-hamburger fa-2x text-muted mb-3"></i>
                            <p class="text-muted">Aucune vente aujourd'hui</p>
                        </div>
                    {% endif %}
                </div>
            </div>
            
            <!-- Actions rapides -->
            <div class="card mt-4">
                <div class="card-header">
                    <h6 class="mb-0 font-weight-bold">
                        <i class="fas fa-bolt me-2"></i>Actions rapides
                    </h6>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a href="{{ path('gestion_commande_affectation_livraison') }}" 
                           class="btn btn-warning">
                            <i class="fas fa-truck me-2"></i>Affecter livreur
                        </a>
                        <a href="{{ path('gestion_burger_new') }}" 
                           class="btn btn-success">
                            <i class="fas fa-plus me-2"></i>Nouveau burger
                        </a>
                        <a href="{{ path('gestion_menu_new') }}" 
                           class="btn btn-success">
                            <i class="fas fa-plus me-2"></i>Nouveau menu
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}