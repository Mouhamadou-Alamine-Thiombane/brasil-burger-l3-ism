{% extends 'base.html.twig' %}

{% block title %}Gestion des menus - Brasil Burger{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <h1 class="h3 mb-0">
                    <i class="fas fa-list me-2"></i>Gestion des menus
                </h1>
                <a href="{{ path('gestion_menu_new') }}" class="btn btn-primary">
                    <i class="fas fa-plus me-2"></i>Nouveau menu
                </a>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nom</th>
                            <th>Composition</th>
                            <th>Prix</th>
                            <th>Image</th>
                            <th>Créé le</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for menu in menus %}
                        <tr>
                            <td>#{{ menu.id }}</td>
                            <td>
                                <strong>{{ menu.nom }}</strong>
                            </td>
                            <td>
                                <small class="text-muted">
                                    {{ menu.burger.nom }}
                                    {% if menu.frite %} + {{ menu.frite.nom }}{% endif %}
                                    {% if menu.boisson %} + {{ menu.boisson.nom }}{% endif %}
                                </small>
                            </td>
                            <td>{{ menu.prix|format_currency('XOF') }}</td>
                            <td>
                                {% if menu.image %}
                                    <img src="{{ menu.image }}" alt="{{ menu.nom }}" style="width: 50px; height: 50px; object-fit: cover; border-radius: 5px;">
                                {% else %}
                                    <span class="badge bg-secondary">Aucune</span>
                                {% endif %}
                            </td>
                            <td>{{ menu.createdAt|date('d/m/Y') }}</td>
                            <td>
                                {% if menu.archived %}
                                    <span class="badge bg-danger">Archivé</span>
                                {% else %}
                                    <span class="badge bg-success">Actif</span>
                                {% endif %}
                            </td>
                            <td>
                                <div class="btn-group btn-group-sm" role="group">
                                    <a href="{{ path('gestion_menu_edit', {'id': menu.id}) }}" 
                                       class="btn btn-outline-primary" title="Modifier">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <form method="post" action="{{ path('gestion_menu_archive', {'id': menu.id}) }}" 
                                          class="d-inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('archive' ~ menu.id) }}">
                                        <button type="submit" class="btn btn-outline-warning" title="{{ menu.archived ? 'Désarchiver' : 'Archiver' }}">
                                            <i class="fas {{ menu.archived ? 'fa-box-open' : 'fa-archive' }}"></i>
                                        </button>
                                    </form>
                                    <form method="post" action="{{ path('gestion_menu_delete', {'id': menu.id}) }}" 
                                          class="d-inline" onsubmit="return confirm('Supprimer ce menu ?')">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ menu.id) }}">
                                        <button type="submit" class="btn btn-outline-danger" title="Supprimer">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="8" class="text-center py-4">
                                <i class="fas fa-list fa-2x text-muted mb-3"></i>
                                <p class="text-muted">Aucun menu enregistré</p>
                                <a href="{{ path('gestion_menu_new') }}" class="btn btn-primary">
                                    <i class="fas fa-plus me-2"></i>Ajouter votre premier menu
                                </a>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}